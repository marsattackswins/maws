# Integration Test Configuration
# Copy this file to .env.integration and fill in your testnet credentials

# ============================================================================
# BINANCE TESTNET CREDENTIALS (REQUIRED)
# ============================================================================
# Get these from: https://testnet.binancefuture.com
# 1. Create testnet account (free, separate from main Binance)
# 2. Generate API key with futures trading enabled
# 3. Fund account using testnet's "Get Testnet Funds" feature
# ============================================================================

MAWS_DEFAULT_PROFILE=paper
MAWS_BINANCE_TESTNET_API_KEY=your-testnet-api-key-here
MAWS_BINANCE_TESTNET_API_SECRET=your-testnet-secret-here
MAWS_BINANCE_TESTNET_EXECUTION_ENABLED=false

# Legacy compatibility alternative (do not set these to different values from
# the profile-specific pair when MAWS_ENV=testnet):
# MAWS_BINANCE_API_KEY=your-testnet-api-key-here
# MAWS_BINANCE_API_SECRET=your-testnet-secret-here

# ============================================================================
# OPTIONAL: MONITORING
# ============================================================================
# Uncomment to receive test failure notifications via webhook
# MAWS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE

# ============================================================================
# OPTIONAL: TEST BEHAVIOR
# ============================================================================
# Enable verbose logging for debugging test failures
# MAWS_TEST_VERBOSE=true

# Slower test timeouts for unstable network connections (milliseconds)
# MAWS_TEST_TIMEOUT_MULTIPLIER=2.0
