# Local secrets — copy values as needed. Never commit real keys.

# Finnhub (market news). Free key: https://finnhub.io/register

# FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Development / Debugging flags (client-side, visible in browser)
# ---------------------------------------------------------------------------

# Enable detailed candle synchronization diagnostics in the browser console.
# Logs REST/WebSocket events, merge results, duplicates, and validation errors.
# Only enable for local debugging; never in production.
# NEXT_PUBLIC_DEBUG_CANDLES=false

# ---------------------------------------------------------------------------
# MAWS live-trading server configuration.
# All MAWS_* variables are server-only. Nothing here may use NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Environment: local | testnet | shadow | production   (default: local)
#   local      = Chart Only startup; Paper, Testnet, and Production can be attached from the UI.
#   testnet    = Binance USD-M Futures Testnet (testnet.binancefuture.com).
#   shadow     = production market data + read-only account. Zero submissions.
#   production = real trading, only if execution gates are also opened.
# MAWS_ENV=local

# Optional profile label metadata. The UI controls the active profile after startup;
# this value does not switch the runtime. Defaults to paper.
# MAWS_DEFAULT_PROFILE=paper

# Broker type: binance (default: binance)
#   Currently only Binance is supported. Future: bybit, okx, etc.
# MAWS_BROKER_TYPE=binance

# SQLite database path (default: .maws/maws.db, created with mode 0600).
# MAWS_DB_PATH=

# Operator credential. Generate with: npm run gen-operator-auth
# Format: <hex salt>:<hex scrypt hash>
# MAWS_OPERATOR_AUTH=

# Exact origin allowed for browser requests, e.g. https://terminal.example.com
# MAWS_ALLOWED_ORIGIN=

# Set to true ONLY when the reverse proxy strips inbound forwarding headers
# and sets a single trusted X-Forwarded-For. Default: false (use socket IP).
# MAWS_TRUST_PROXY=

# 64-hex AES-256 key for encrypted DB backups (npm run gen-operator-auth never
# prints this; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Restore from backup: node scripts/restore-backup.mjs .maws/backups/<file>.db.enc [--dry-run]
# MAWS_BACKUP_KEY=

# Static execution gate. Must be literally "true" AND the runtime flag enabled
# (POST /api/live/gates) before production submissions are accepted.
# Shadow mode ignores this entirely: it can never submit orders.
# MAWS_EXECUTION_ENABLED=

# Optional shared token for operational health endpoints.
# Send via x-maws-health-token header (never in URLs or query parameters).
# MAWS_HEALTH_TOKEN=

# Separate server-only profile credentials used by the UI profile chooser. Never use NEXT_PUBLIC_ for
# any of these values. Missing credentials leave that profile unconfigured.
# Testnet keys from https://testnet.binancefuture.com only.
# MAWS_BINANCE_TESTNET_API_KEY=
# MAWS_BINANCE_TESTNET_API_SECRET=
# MAWS_BINANCE_TESTNET_EXECUTION_ENABLED=false
#
# Production keys for the Production profile and Shadow's read-only account;
# withdrawal permission MUST be off. Production execution remains disabled unless
# this profile-specific flag is explicitly true AND existing execution gates pass.
# MAWS_BINANCE_PRODUCTION_API_KEY=
# MAWS_BINANCE_PRODUCTION_API_SECRET=
# MAWS_BINANCE_PRODUCTION_EXECUTION_ENABLED=false

# Migration compatibility: these legacy variables still configure the active
# profile selected by MAWS_ENV. If both legacy and active profile credentials are
# supplied with different values, startup fails closed.
# MAWS_BINANCE_API_KEY=
# MAWS_BINANCE_API_SECRET=

# Optional tuning (defaults shown).
# MAWS_RECV_WINDOW_MS=5000
# MAWS_RATE_INTERNAL_PER_MIN=60
# MAWS_RECON_INTERVAL_MS=60000
# MAWS_LEASE_TTL_MS=60000

# Out-of-band webhook alerts (optional). Fires on fills, freezes, stream failures.
# Supports Discord, Slack, PagerDuty, or any JSON POST endpoint.
# MAWS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Risk limits (USD / counts / percent).
# Production requires all values to be positive finite numbers (fail closed).
# MAWS_RISK_MAX_ORDER_NOTIONAL=100
# MAWS_RISK_MAX_GROSS_EXPOSURE=500
# MAWS_RISK_MAX_OPEN_ORDERS=10
# MAWS_RISK_MAX_OPEN_POSITIONS=1
# MAWS_RISK_DAILY_LOSS_PCT=50
# MAWS_RISK_PRICE_COLLAR_PCT=5

# Circuit Breaker Configuration (for failure isolation and automatic recovery)
# Binance REST API breaker (defaults: 5 failures in 60s, retry after 30s)
# MAWS_CB_REST_FAILURE_THRESHOLD=5
# MAWS_CB_REST_FAILURE_WINDOW_MS=60000
# MAWS_CB_REST_RECOVERY_TIMEOUT_MS=30000
# MAWS_CB_REST_SUCCESS_THRESHOLD=2

# WebSocket stream breaker (defaults: 3 failures in 5min, retry after 60s)
# MAWS_CB_STREAM_FAILURE_THRESHOLD=3
# MAWS_CB_STREAM_FAILURE_WINDOW_MS=300000
# MAWS_CB_STREAM_RECOVERY_TIMEOUT_MS=60000
# MAWS_CB_STREAM_SUCCESS_THRESHOLD=1

# Reconciliation breaker (defaults: 3 failures in 10min, retry after 120s)
# MAWS_CB_RECON_FAILURE_THRESHOLD=3
# MAWS_CB_RECON_FAILURE_WINDOW_MS=600000
# MAWS_CB_RECON_RECOVERY_TIMEOUT_MS=120000
# MAWS_CB_RECON_SUCCESS_THRESHOLD=2
