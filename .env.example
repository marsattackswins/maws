# MAWS environment template
# Copy this file to .env.local.

# Start MAWS in Chart Only mode.
MAWS_ENV=local

# Needed only when connecting Binance Testnet or Production.
# Generate with: npm run gen-operator-auth
MAWS_OPERATOR_AUTH=

# Binance Testnet credentials. Leave blank if you do not use Testnet.
MAWS_BINANCE_TESTNET_API_KEY=
MAWS_BINANCE_TESTNET_API_SECRET=
MAWS_BINANCE_TESTNET_EXECUTION_ENABLED=false

# Binance Production credentials. Leave blank if you do not use Production.
# Disable withdrawals on the Binance API key.
MAWS_BINANCE_PRODUCTION_API_KEY=
MAWS_BINANCE_PRODUCTION_API_SECRET=
MAWS_BINANCE_PRODUCTION_EXECUTION_ENABLED=false

# Keep order execution disabled until you are ready.
MAWS_EXECUTION_ENABLED=false

# Optional risk limits. Leave commented unless you want to customize them.
# MAWS_RISK_MAX_ORDER_NOTIONAL=50
# MAWS_RISK_MAX_GROSS_EXPOSURE=100
# MAWS_RISK_MAX_OPEN_ORDERS=10
# MAWS_RISK_MAX_OPEN_POSITIONS=3
# MAWS_RISK_DAILY_LOSS_PCT=50
# MAWS_RISK_PRICE_COLLAR_PCT=5
